<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  每天本地时间 08:00 刷新数据库。08:00 依赖 Mac 的系统时区，请设为 Asia/Shanghai，
  这样就是北京时间早上 8 点，避开 09:15–09:25 集合竞价。
  复制到 ~/Library/LaunchAgents/ 后，把 REPLACE_WITH_PROJECT_PATH 换成项目绝对路径。
  步骤见 文档/08-Mac-mini常驻与自动刷新.md。
-->
<dict>
	<key>Label</key>
	<string>com.stock-analysis.daily-refresh</string>
	<key>ProgramArguments</key>
	<array>
		<string>REPLACE_WITH_PROJECT_PATH/scripts/daily_refresh.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>REPLACE_WITH_PROJECT_PATH</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>8</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>REPLACE_WITH_PROJECT_PATH/logs/daily_refresh.launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>REPLACE_WITH_PROJECT_PATH/logs/daily_refresh.launchd.err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
</dict>
</plist>
