<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Mac mini 常驻网站。复制到 ~/Library/LaunchAgents/ 后，把 REPLACE_WITH_PROJECT_PATH
  换成项目绝对路径。步骤见 文档/08-Mac-mini常驻与自动刷新.md。
  时区请设为 Asia/Shanghai。本文件只负责网站，每天刷新见另一份 plist。
-->
<dict>
	<key>Label</key>
	<string>com.stock-analysis.serve</string>
	<key>ProgramArguments</key>
	<array>
		<string>REPLACE_WITH_PROJECT_PATH/scripts/serve_always.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>REPLACE_WITH_PROJECT_PATH</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>REPLACE_WITH_PROJECT_PATH/logs/serve_always.out.log</string>
	<key>StandardErrorPath</key>
	<string>REPLACE_WITH_PROJECT_PATH/logs/serve_always.err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
</dict>
</plist>
